[Unit]
Description=Hologram VR helmet
After=multi-user.target sound.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO@
Environment=PYTHONUNBUFFERED=1
Environment=SDL_VIDEODRIVER=kmsdrm
ExecStart=/usr/bin/python3 -m hologram.vr run --config /etc/hologram/vr.toml
Restart=on-failure
RestartSec=2
SupplementaryGroups=video render input gpio i2c audio

[Install]
WantedBy=multi-user.target
